import os
import pandas as pd
import numpy as np
import statsmodels.api as sm
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score, calinski_harabasz_score, davies_bouldin_score

# ----------------------------------------
# LOAD AND PREPARE DATA
# ----------------------------------------

folder_path = # insert path
file_name = # insert file name
file_path = os.path.join(folder_path, file_name)

if not os.path.exists(file_path):
    raise FileNotFoundError("File not found")

df = pd.read_csv(
    file_path,
    sep=';',
    engine='python',
    encoding='latin1',
    decimal=',',
    on_bad_lines='warn'
)

df_clean = df.replace(-99, np.nan)


# ----------------------------------------
# Variables for Residualization
# ----------------------------------------

demo_vars = ['Age', 'Sex']
demo = df_clean[demo_vars]

# ----------------------------------------
# PCA
# ----------------------------------------

test_variablen = {} # insert variables

pca_scores = pd.DataFrame(index=df_clean.index)

for test, vars_ in test_variablen.items():
    vars_ = [v for v in vars_ if v in df_clean.columns]
    data = df_clean[vars_].dropna()

    if len(vars_) < 2:
        continue

    pca = PCA(n_components=1)
    comp = pca.fit_transform(data)

    temp = pd.Series(comp[:, 0], index=data.index, name=f"{test}_PC1")
    pca_scores = pca_scores.join(temp, how='left')

    print(f"{test} Varianz erklärt: {pca.explained_variance_ratio_[0]:.2%}")

# ----------------------------------------
# Single Variables / Sum Scores
# ----------------------------------------

einzelvariablen = []
einzel_df = df_clean[einzelvariablen]

X_features = pd.concat([pca_scores, einzel_df], axis=1)

# ----------------------------------------
# RESIDUALIZATION
# ----------------------------------------

X_resid = pd.DataFrame(index=X_features.index)

for col in X_features.columns:
    model = sm.OLS(X_features[col], sm.add_constant(demo), missing='drop').fit()
    X_resid[col] = model.resid

# ----------------------------------------
# GAP STATISTIC
# ----------------------------------------

def gap_statistic(X, k_max=10, B=20):
    gaps = []
    k_range = range(1, k_max + 1)

    for k in k_range:
        km = KMeans(n_clusters=k, random_state=42, n_init=30).fit(X)
        disp = km.inertia_

        ref = []
        for _ in range(B):
            rand = np.random.uniform(X.min(), X.max(), X.shape)
            ref_km = KMeans(n_clusters=k, random_state=42, n_init=30).fit(rand)
            ref.append(ref_km.inertia_)

        gap = np.mean(np.log(ref)) - np.log(disp)
        gaps.append(gap)

    optimal_k = k_range[np.argmax(gaps)]

    return optimal_k, gaps, list(k_range)


X_model = X_resid.dropna()
optimal_k, gaps, gap_k = gap_statistic(X_model)

# ----------------------------------------
# MANUALLY SELECT k AFTER CONSIDERATION OF CLUSTER METRICES
# ----------------------------------------

# None = automatically (not recommended)
# oder manually after careful consideration of cluster metrices
manual_k = 2

if manual_k is None:
    k = optimal_k
    print(f"Use optimal k from Gap Statistic: {k}")
else:
    k = manual_k
    print(f" Set k manually {k}")

final_kmeans = KMeans(n_clusters=k, random_state=42, n_init=30)
clusters = final_kmeans.fit_predict(X_model)

df_final = df_clean.loc[X_model.index].copy()
df_final['Cluster'] = clusters + 1

# ----------------------------------------
# PCA for Cluster Visualization
# ----------------------------------------

pca_vis = PCA(n_components=2)
X_vis = pca_vis.fit_transform(X_model)

# ----------------------------------------
# k means Metrices: CALINSKI-HARABASZ, SILHOUETTE,
# INERTIA & DAVIES-BOULDIN
# ----------------------------------------

k_range = range(2, 11)

calinski_scores = []
silhouette_scores = []
inertia_scores = []
davies_bouldin_scores = []

for k_eval in k_range:
    kmeans = KMeans(n_clusters=k_eval, random_state=42, n_init=30)
    labels = kmeans.fit_predict(X_model)

    calinski_scores.append(
        calinski_harabasz_score(X_model, labels)
    )

    silhouette_scores.append(
        silhouette_score(X_model, labels)
    )

    inertia_scores.append(
        kmeans.inertia_
    )

    davies_bouldin_scores.append(
        davies_bouldin_score(X_model, labels)
    )

# ----------------------------------------
# VISUALISIZATION
# ----------------------------------------

plt.figure(figsize=(18, 10))

# 1. Calinski-Harabasz
plt.subplot(2, 3, 1)
plt.plot(k_range, calinski_scores, marker='o', color='blue')
plt.title("Calinski-Harabasz Index (CHI)")
plt.xlabel("Cluster (k)")
plt.ylabel("CH")
plt.grid(True, alpha=0.3)

# 2. Silhouette
plt.subplot(2, 3, 2)
plt.plot(k_range, silhouette_scores, marker='s', color='red')
plt.title("Silhouette Score (Sil)")
plt.xlabel("Cluster (k)")
plt.ylabel("Sil")
plt.grid(True, alpha=0.3)

# 3. Elbow
plt.subplot(2, 3, 3)
plt.plot(k_range, inertia_scores, marker='^', color='green')
plt.title("Elbow Plot")
plt.xlabel("Cluster (k)")
plt.ylabel("Inertia")
plt.grid(True, alpha=0.3)

# 4. Davies-Bouldin
plt.subplot(2, 3, 4)
plt.plot(k_range, davies_bouldin_scores, marker='d', color='purple')
plt.title("Davies-Bouldin Index (DBI)")
plt.xlabel("Cluster (k)")
plt.ylabel("DBI")
plt.grid(True, alpha=0.3)

# 5. Gap Statistic
plt.subplot(2, 3, 5)
plt.plot(gap_k, gaps, marker='o', color='blue')
plt.title("Gap Statistic")
plt.xlabel("Cluster (k)")
plt.ylabel("Gap Value")
plt.grid(True, alpha=0.3)


# 6. Cluster Visualization
plt.subplot(2, 3, 6)

# choose Color 
if k == 2:
    palette = {
        1: "#2C7BB6",   # Blau
        2: "#D7191C"    # Rot
    }
else:
    palette = "Set2"

sns.scatterplot(
    x=X_vis[:, 0],
    y=X_vis[:, 1],
    hue=df_final['Cluster'],
    palette=palette,
    s=60
)

# Cluster Center
centers_vis = pca_vis.transform(final_kmeans.cluster_centers_)

# Use black cross
plt.scatter(
    centers_vis[:, 0],
    centers_vis[:, 1],
    marker='x',
    s=250,
    c='black',
    linewidths=3,
    label='Cluster Center'
)

plt.title(f"Cluster (2D PCA)")
plt.xlabel("PC1")
plt.ylabel("PC2")
plt.legend()

plt.tight_layout()

plt.savefig(
    os.path.join(folder_path, f"Cluster_Evaluation_k{k}.png"),
    dpi=300,
    bbox_inches="tight"
)
plt.show()

# ----------------------------------------
# Table of all Cluster Metrices
# ----------------------------------------

metrics_table = pd.DataFrame({
    "k": list(k_range),
    "Calinski_Harabasz": calinski_scores,
    "Silhouette": silhouette_scores,
    "Inertia": inertia_scores,
    "Davies_Bouldin": davies_bouldin_scores
})

metrics_table.to_excel(
    os.path.join(folder_path, f"Cluster_Metrices_k{k}.xlsx"),
    index=False
)

print("\nCluster Validation Metrics (k = 2 bis 10):")
print(metrics_table.round(3))

# ----------------------------------------
# CLUSTER × DIAGNOSE
# ----------------------------------------

ct = pd.crosstab(df_final['Cluster'], df_final['Group'])
print("\nCluster × Group:")
print(ct)

print("\nCluster sizes:")
print(df_final['Cluster'].value_counts())


# ============================================================
# BOOTsTRAP Stability of Cluster Solution
# ============================================================

from sklearn.metrics import adjusted_rand_score

n_bootstraps = 1000
rng = np.random.default_rng(42)

X_array = X_model.to_numpy()
reference_labels = np.asarray(clusters)
n_samples = len(X_array)

bootstrap_ari = []
coassignment_counts = np.zeros(
    (n_samples, n_samples),
    dtype=np.float64,
)

for b in range(n_bootstraps):
    # Bootstrap-Stichprobe mit Zurücklegen
    bootstrap_indices = rng.integers(
        low=0,
        high=n_samples,
        size=n_samples,
    )
    X_boot = X_array[bootstrap_indices]

    bootstrap_model = KMeans(
        n_clusters=k,
        random_state=42 + b,
        n_init=30,
    )
    bootstrap_model.fit(X_boot)

    bootstrap_labels = bootstrap_model.predict(X_array)


    bootstrap_ari.append(
        adjusted_rand_score(reference_labels, bootstrap_labels)
    )


    coassignment_counts += (
        bootstrap_labels[:, None] == bootstrap_labels[None, :]
    )

bootstrap_ari = np.asarray(bootstrap_ari)
coassignment = coassignment_counts / n_bootstraps

coassignment_df = pd.DataFrame(
    coassignment,
    index=X_model.index,
    columns=X_model.index,
)
