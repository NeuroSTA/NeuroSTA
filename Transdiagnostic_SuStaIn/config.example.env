# Repository or local analysis root
SUSTAIN_PROJECT_DIR=/path/to/local/project

# Optional overrides for controlled-access source files
SUSTAIN_T1_ROI_FILE=/path/to/merged_data_avg_only.csv
SUSTAIN_COVARIATE_FILE=/path/to/Datenbank_Update_DataFreeze_bereinigt.csv
SUSTAIN_CLINICAL_FILE=/path/to/Datenbank_Update_DataFreeze_bereinigt.csv
SUSTAIN_CLINICAL_STATUS_FILE=/path/to/Datenbank_Update_DataFreeze_bereinigt_withGlobalRatings.csv

# Optional cluster environment name used by the SLURM wrappers
SUSTAIN_CONDA_ENV=sustain_env
